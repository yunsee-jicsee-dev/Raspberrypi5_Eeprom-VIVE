#!/bin/sh
# vive-boot-gate - 암호화하지 않은 루트에 '플로피가 없으면 부팅 안 함' 을 건다.
#
#   enable   이 토큰이 있어야 부팅되게 한다
#   disable  게이트를 끈다
#   status   현재 상태
#
# LUKS 를 쓰지 않는 구성용이다. 루트가 평문이므로 SSD 를 떼어 다른 기계에
# 꽂으면 내용이 보인다 - 이 게이트는 '이 기기를 켜서 쓰는 것' 만 막는다.
# 데이터까지 지키려면 루트를 LUKS 로 암호화하고 vive-luks-enroll 을 쓴다.
set -eu

VB_TAG="vive-boot-gate"

# 경로/명령은 테스트에서만 덮어쓴다.
VB_LIB=${VIVEBOOT_LIB:-/usr/lib/viveboot/viveboot-common.sh}
VB_CONF=${VIVEBOOT_CONF:-/etc/viveboot/viveboot.conf}
VB_GATE=${VIVEBOOT_GATE:-/etc/viveboot/gate}
KEYSCRIPT=${KEYSCRIPT:-/usr/lib/viveboot/viveboot-keyscript}
TOKEN_TOOL=${TOKEN_TOOL:-/usr/bin/vive-floppy-token}
UPDATE_INITRAMFS=${UPDATE_INITRAMFS:-update-initramfs}
LSINITRAMFS=${LSINITRAMFS:-lsinitramfs}
BOOT_CONFIG=${VIVEBOOT_BOOT_CONFIG:-/boot/firmware/config.txt}
TMPBASE=${VIVEBOOT_TMPBASE:-/run}

log() { printf '%s: %s\n' "$VB_TAG" "$*" >&2; }
warn() { printf '%s: 경고: %s\n' "$VB_TAG" "$*" >&2; }
die() {
	printf '%s: 오류: %s\n' "$VB_TAG" "$*" >&2
	exit 1
}

[ -r "$VB_LIB" ] || die "$VB_LIB 를 찾을 수 없습니다 (install.sh 를 먼저 실행하세요)"
# shellcheck source=../lib/viveboot-common.sh
. "$VB_LIB"

usage() {
	cat >&2 <<'USAGE'
사용법:
  vive-boot-gate enable [--token DEV] [--pin PIN] [--no-initramfs]
  vive-boot-gate disable [--no-initramfs]
  vive-boot-gate status

enable 은 먼저 부팅 때와 같은 키스크립트로 토큰을 읽어 확인하고, 그 결과로
검증값을 /etc/viveboot/gate 에 쓴 뒤 initramfs 를 다시 만든다. 새 initramfs
안에 게이트를 통과하는 데 필요한 것이 다 들어갔는지 확인하고, 하나라도
빠졌으면 되돌린다 (빠진 채로 켜지면 매번 전원이 꺼진다).
USAGE
	exit 2
}

CMD=${1:-}
[ -n "$CMD" ] || usage
case $CMD in
enable | disable | status) shift ;;
-h | --help) usage ;;
*) die "알 수 없는 명령: $CMD (enable | disable | status)" ;;
esac

TOKEN=""
PIN=""
HAVE_PIN=no
DO_INITRAMFS=yes
while [ $# -gt 0 ]; do
	case $1 in
	--token) TOKEN=${2:?}; shift 2 ;;
	--pin) PIN=${2:?}; HAVE_PIN=yes; shift 2 ;;
	--no-initramfs) DO_INITRAMFS=no; shift ;;
	-h | --help) usage ;;
	*) die "알 수 없는 인자: $1" ;;
	esac
done

WORK=""
cleanup() {
	[ -n "$WORK" ] || return 0
	rm -rf "$WORK"
}
trap cleanup EXIT HUP INT TERM

workdir() {
	[ -n "$WORK" ] && return 0
	WORK=$(mktemp -d "$TMPBASE/vive-boot-gate.XXXXXX") \
		|| die "$TMPBASE 에 임시 디렉토리를 만들 수 없습니다"
	chmod 700 "$WORK"
}

# initrd 경로 (Pi 5 는 /boot/firmware/initramfs_2712 로 복사된다)
initrd_path() {
	if [ -n "${VIVEBOOT_INITRD:-}" ]; then
		printf '%s' "$VIVEBOOT_INITRD"
		return 0
	fi
	_kr=$(uname -r 2>/dev/null || true)
	for _p in "/boot/initrd.img-$_kr" "/boot/firmware/initramfs_2712" \
		"/boot/firmware/initramfs8" "/boot/initrd.img"; do
		if [ -f "$_p" ]; then
			printf '%s' "$_p"
			return 0
		fi
	done
	return 1
}

# 게이트가 켜진 initramfs 에 반드시 있어야 하는 것
REQUIRED="scripts/local-top/viveboot-gate etc/viveboot/gate
usr/lib/viveboot/viveboot-keyscript usr/lib/viveboot/viveboot-common.sh
bin/openssl"

# initrd_missing <initrd>  -> 빠진 항목을 한 줄에 하나씩
initrd_missing() {
	_ls=$("$LSINITRAMFS" "$1" 2>/dev/null) || {
		printf 'lsinitramfs-실패\n'
		return 0
	}
	for _want in $REQUIRED; do
		printf '%s\n' "$_ls" | grep -q -- "$_want" || printf '%s\n' "$_want"
	done
}

rebuild_initramfs() {
	command -v "$UPDATE_INITRAMFS" >/dev/null 2>&1 \
		|| die "$UPDATE_INITRAMFS 가 없습니다 (apt install initramfs-tools)"
	log "initramfs 를 다시 만듭니다 ($UPDATE_INITRAMFS -u -k all)"
	"$UPDATE_INITRAMFS" -u -k all
}

# ---------------------------------------------------------------------------

cmd_enable() {
	[ "$(id -u)" = 0 ] || [ -n "${VIVEBOOT_TEST:-}" ] || die "root 권한이 필요합니다"
	[ -x "$KEYSCRIPT" ] || [ -r "$KEYSCRIPT" ] || die "$KEYSCRIPT 가 없습니다"
	[ -r /usr/share/initramfs-tools/scripts/local-top/viveboot-gate ] \
		|| [ -n "${VIVEBOOT_TEST:-}" ] \
		|| die "게이트 스크립트가 설치되지 않았습니다 (sudo ./install.sh)"

	if [ -r "$BOOT_CONFIG" ] \
		&& ! grep -qE '^[[:space:]]*(auto_initramfs=1|initramfs[[:space:]])' "$BOOT_CONFIG"; then
		warn "$BOOT_CONFIG 에 auto_initramfs=1 이 없습니다"
		warn "initramfs 로 부팅하지 않으면 게이트가 아예 돌지 않습니다"
	fi

	workdir
	if [ -z "$TOKEN" ]; then
		[ -x "$TOKEN_TOOL" ] || die "$TOKEN_TOOL 가 없습니다. --token 으로 지정하세요"
		TOKEN=$("$TOKEN_TOOL" scan 2>/dev/null | awk 'NR == 1 { print $1 }')
		[ -n "$TOKEN" ] || die "연결된 VIVE 토큰을 찾지 못했습니다. 디스켓을 넣거나 --token 을 쓰세요"
	fi
	log "토큰: $TOKEN"

	VB_TMPDIR=$WORK
	vb_parse_header "$TOKEN" || die "$TOKEN 의 토큰 헤더를 읽을 수 없습니다"
	if [ "$VB_PIN_REQUIRED" -eq 1 ] && ! vb_askpass_path >/dev/null; then
		warn "이 토큰은 PIN 을 씁니다. 부팅 화면에서 PIN 을 제대로 받으려면"
		warn "askpass 가 필요합니다: sudo apt install cryptsetup-initramfs"
	fi

	# 부팅 때와 같은 키스크립트로 읽는다. 카운터는 올리지 않는다.
	{
		printf 'TOKEN_DEVICE="%s"\n' "$TOKEN"
		printf 'TOKEN_WAIT=10\nSEQ_UPDATE=no\nCACHE_IKM=no\nBYPASS_CMDLINE=no\n'
	} > "$WORK/conf"
	mkdir -p "$WORK/run"
	log "부팅 때와 같은 경로로 토큰을 읽습니다"
	if [ "$HAVE_PIN" = yes ]; then
		_pp=$(VIVEBOOT_LIB="$VB_LIB" VIVEBOOT_CONF="$WORK/conf" \
			VIVEBOOT_RUN="$WORK/run" VIVEBOOT_CMDLINE=/dev/null \
			VIVEBOOT_PIN="$PIN" sh "$KEYSCRIPT" none) || _pp=""
	else
		_pp=$(VIVEBOOT_LIB="$VB_LIB" VIVEBOOT_CONF="$WORK/conf" \
			VIVEBOOT_RUN="$WORK/run" VIVEBOOT_CMDLINE=/dev/null \
			sh "$KEYSCRIPT" none) || _pp=""
	fi
	[ ${#_pp} -eq 64 ] || die "토큰에서 키를 파생하지 못했습니다. 게이트를 켜지 않았습니다"
	_ver=$(vb_hmac_hex "$_pp" "viveboot-gate-v1")
	_pp=""
	[ ${#_ver} -eq 64 ] || die "검증값 계산 실패"

	_had_gate=no
	if [ -e "$VB_GATE" ]; then
		_had_gate=yes
		cp -a "$VB_GATE" "$WORK/gate.bak"
	fi
	mkdir -p "$(dirname "$VB_GATE")"
	( umask 077 && {
		printf '# viveboot 부팅 게이트 - vive-boot-gate 가 관리한다. 직접 고치지 말 것\n'
		printf 'version=1\n'
		printf 'token_uuid=%s\n' "$VB_UUID_HEX"
		printf 'verifier=%s\n' "$_ver"
	} > "$VB_GATE.new" ) && mv "$VB_GATE.new" "$VB_GATE"
	log "$VB_GATE 를 썼습니다 (토큰 UUID $VB_UUID_HEX)"

	if [ "$DO_INITRAMFS" = no ]; then
		warn "initramfs 를 다시 만들지 않았습니다. 다음으로 반영하세요:"
		warn "  sudo update-initramfs -u -k all && sudo vive-boot-gate status"
		return 0
	fi

	rollback() {
		warn "$1"
		if [ "$_had_gate" = yes ]; then
			cp -a "$WORK/gate.bak" "$VB_GATE"
		else
			rm -f "$VB_GATE"
		fi
		"$UPDATE_INITRAMFS" -u -k all || warn "되돌린 뒤의 재생성도 실패했습니다"
		die "게이트를 켜지 않았습니다. 재부팅해도 이전 상태 그대로입니다"
	}

	"$UPDATE_INITRAMFS" -u -k all || rollback "update-initramfs 실패"
	_ird=$(initrd_path) || rollback "initrd 파일을 찾지 못해 확인할 수 없습니다"
	_miss=$(initrd_missing "$_ird")
	if [ -n "$_miss" ]; then
		rollback "$_ird 에 다음이 없습니다: $(printf '%s' "$_miss" | tr '\n' ' ')"
	fi
	log "확인: $_ird 에 게이트에 필요한 것이 모두 들어 있습니다"

	cat >&2 <<EOF

$VB_TAG: 켰습니다. 다음 부팅부터 이 디스켓이 USB 드라이브에 있어야 합니다.
         없으면 기다리다가 (TOKEN_WAIT x GATE_TRIES) 전원이 꺼집니다.

못 들어갈 때:
  - 디스켓을 잃었거나 상했으면: 다른 기계에서 부트 파티션의 cmdline.txt 끝에
    ' viveboot=off' 를 붙이고 부팅 -> 들어가서 sudo vive-boot-gate disable
  - 백업 이미지로 새 디스켓을 만들 수도 있다: vive-floppy-token restore
EOF
}

cmd_disable() {
	[ "$(id -u)" = 0 ] || [ -n "${VIVEBOOT_TEST:-}" ] || die "root 권한이 필요합니다"
	if [ ! -e "$VB_GATE" ]; then
		log "게이트가 이미 꺼져 있습니다 ($VB_GATE 없음)"
	else
		rm -f "$VB_GATE"
		log "$VB_GATE 를 지웠습니다"
	fi
	if [ "$DO_INITRAMFS" = no ]; then
		warn "initramfs 를 다시 만들기 전까지는 다음 부팅에서도 게이트가 돈다"
		return 0
	fi
	rebuild_initramfs
	if _ird=$(initrd_path) \
		&& "$LSINITRAMFS" "$_ird" 2>/dev/null | grep -q 'etc/viveboot/gate$'; then
		die "$_ird 안에 아직 gate 가 있습니다. update-initramfs 를 확인하세요"
	fi
	log "껐습니다. 다음 부팅은 토큰 없이 진행됩니다"
}

cmd_status() {
	printf '== viveboot 부팅 게이트 ==\n'
	if [ -e "$VB_GATE" ]; then
		printf '설정          : 켜짐 (%s)\n' "$VB_GATE"
		printf '토큰 UUID     : %s\n' "$(sed -n 's/^token_uuid=//p' "$VB_GATE")"
	else
		printf '설정          : 꺼짐 (%s 없음)\n' "$VB_GATE"
	fi
	if _ird=$(initrd_path); then
		printf 'initramfs     : %s\n' "$_ird"
		if command -v "$LSINITRAMFS" >/dev/null 2>&1; then
			if "$LSINITRAMFS" "$_ird" 2>/dev/null | grep -q 'etc/viveboot/gate$'; then
				printf '다음 부팅     : 게이트 동작 (토큰 필요)\n'
				_miss=$(initrd_missing "$_ird")
				[ -z "$_miss" ] \
					|| printf '  빠진 것!    : %s\n' "$(printf '%s' "$_miss" | tr '\n' ' ')"
			else
				printf '다음 부팅     : 게이트 없음\n'
			fi
		fi
		if [ -e "$VB_GATE" ] && [ -n "$(find "$VB_GATE" -newer "$_ird" 2>/dev/null)" ]; then
			printf '  주의        : gate 가 initramfs 보다 새롭다 -> update-initramfs -u -k all\n'
		fi
	else
		printf 'initramfs     : 찾지 못함\n'
	fi
	if [ -r "$VB_CONF" ] && grep -qE '^[[:space:]]*BYPASS_CMDLINE=no' "$VB_CONF"; then
		printf '우회          : 막힘 (BYPASS_CMDLINE=no)\n'
	else
		printf '우회          : cmdline.txt 에 viveboot=off 로 가능\n'
	fi
}

case $CMD in
enable) cmd_enable ;;
disable) cmd_disable ;;
status) cmd_status ;;
esac
