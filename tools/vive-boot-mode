# status
# ---------------------------------------------------------------------------

# vb_initrd  -> 검사할 initrd 경로 (없으면 빈 문자열)
vb_initrd() {
	if [ -n "${VIVEBOOT_INITRD:-}" ]; then
		printf '%s' "$VIVEBOOT_INITRD"
		return 0
	fi
	_kr=$(uname -r 2>/dev/null || true)
	for _p in "/boot/initrd.img-$_kr" "/boot/initramfs-$_kr.img" \
		"/boot/initrd.img" "/boot/firmware/initramfs8" \
		"/boot/firmware/initramfs_2712"; do
		[ -f "$_p" ] && { printf '%s' "$_p"; return 0; }
	done
	return 1
}

vb_check_initramfs_has_keyscript() {
	_ird=$(vb_initrd) || { warn "initrd 파일을 찾지 못해 확인하지 못했습니다"; return 1; }
	command -v "$LSINITRAMFS" >/dev/null 2>&1 || return 1
	if "$LSINITRAMFS" "$_ird" 2>/dev/null | grep -q 'viveboot-keyscript'; then
		log "확인: $_ird 안에 키스크립트가 있습니다"
		return 0
	fi
	warn "$_ird 안에 viveboot-keyscript 가 없습니다!"
	warn "이 상태로 켜 두면 cryptsetup 이 항목을 건너뛰고 패스프레이즈도 묻지 않습니다"
	warn "initramfs/hooks/viveboot 설치와 update-initramfs 를 확인하세요"
	return 1
}

cmd_status() {
	_target=$NAME
	[ -n "$_target" ] || _target=$(vb_pick_name 2>/dev/null) || _target=""
	_mode=none
	[ -n "$_target" ] && _mode=$(vb_mode_of "$_target")

	printf '%s\n' "== viveboot 부팅 모드 =="
	case $_mode in
	on) printf '모드          : on  - 토큰 플로피가 있어야 루트가 열린다\n' ;;
	off) printf '모드          : off - LUKS 패스프레이즈로 루트를 연다\n' ;;
	other) printf '모드          : 다른 keyscript (%s)\n' "$(vb_keyscript_of "$_target")" ;;
	*) printf '모드          : 미설정 - crypttab 에 대상 항목이 없다\n' ;;
	esac
	[ -n "$_target" ] && printf '대상 매핑     : %s\n' "$_target"

	printf '\n-- crypttab (%s) --\n' "$CRYPTTAB"
	vb_names | while IFS= read -r _n; do
		printf '  %-12s %-28s %s\n' "$_n" "$(vb_field "$_n" 2)" "$(vb_field "$_n" 4)"
		_k=$(vb_keyscript_of "$_n")
		if [ -z "$_k" ]; then
			printf '  %-12s   -> keyscript 없음 (패스프레이즈)\n' ""
		elif [ "$_k" = "$KEYSCRIPT" ]; then
			printf '  %-12s   -> viveboot keyscript (토큰 필수)\n' ""
		else
			printf '  %-12s   -> 다른 keyscript: %s\n' "" "$_k"
		fi
	done

	printf '\n-- LUKS --\n'
	_dev=$CRYPTDEV
	[ -n "$_dev" ] || { [ -n "$_target" ] && _dev=$(vb_resolve_source "$(vb_field "$_target" 2)"); }
	if [ -z "$_dev" ]; then
		printf '  장치        : 알 수 없음\n'
	elif [ ! -e "$_dev" ]; then
		printf '  장치        : %s (지금은 없음)\n' "$_dev"
	elif [ ! -r "$_dev" ]; then
		printf '  장치        : %s (키슬롯 조회에는 root 권한이 필요)\n' "$_dev"
	else
		printf '  장치        : %s\n' "$_dev"
		_slots=$(vb_keyslots "$_dev" | tr '\n' ' ')
		_nslots=$(printf '%s' "$_slots" | wc -w)
		printf '  키슬롯      : %s개 [%s]\n' "$_nslots" "${_slots% }"
		if [ "$_nslots" -ge 2 ]; then
			printf '  복구 경로   : 토큰 외의 슬롯이 있다 (패스프레이즈로 추정)\n'
		else
			printf '  복구 경로   : 슬롯이 %s개뿐 - 복구 수단이 없을 수 있다!\n' "$_nslots"
		fi
		printf '  실제 확인   : sudo cryptsetup luksOpen --test-passphrase %s\n' "$_dev"
	fi

	printf '\n-- initramfs --\n'
	if _ird=$(vb_initrd); then
		printf '  이미지      : %s\n' "$_ird"
		if command -v "$LSINITRAMFS" >/dev/null 2>&1 \
			&& _ls=$("$LSINITRAMFS" "$_ird" 2>/dev/null); then
			for _want in viveboot-keyscript viveboot-common.sh \
				viveboot/viveboot.conf bin/openssl cryptsetup/askpass; do
				if printf '%s\n' "$_ls" | grep -q -- "$_want"; then
					printf '  %-26s: 있음\n' "$_want"
				else
					printf '  %-26s: 없음\n' "$_want"
				fi
			done
			printf '  (askpass 는 off 모드와 우회 모드에서 패스프레이즈를 묻는 데 쓴다)\n'
		else
			printf '  내용 확인   : lsinitramfs 를 쓸 수 없어 생략\n'
		fi
		if [ -n "$(find "$CRYPTTAB" -newer "$_ird" 2>/dev/null)" ] \
			|| { [ -r "$VB_CONF" ] \
				&& [ -n "$(find "$VB_CONF" -newer "$_ird" 2>/dev/null)" ]; }; then
			printf '  최신 여부   : crypttab/conf 가 더 새롭다 -> update-initramfs -u -k all 필요!\n'
		else
			printf '  최신 여부   : crypttab/conf 보다 새롭다 (반영됨)\n'
		fi
	else
		printf '  이미지      : 찾지 못했다 (VIVEBOOT_INITRD 로 지정 가능)\n'
	fi

	printf '\n-- 토큰 --\n'
	_tok=$TOKEN
	if [ -z "$_tok" ] && [ -x "$TOKEN_TOOL" ]; then
		_tok=$("$TOKEN_TOOL" scan 2>/dev/null | awk 'NR == 1 { print $1 }') || _tok=""
	fi
	if [ -z "$_tok" ]; then
		printf '  연결        : 없음 (디스켓이 꽂혀 있지 않거나 드라이브가 없다)\n'
	else
		printf '  연결        : %s\n' "$_tok"
		if [ -x "$TOKEN_TOOL" ]; then
			"$TOKEN_TOOL" info "$_tok" 2>/dev/null \
				| awk -F: '/라벨|토큰 UUID|PIN 필요|부팅 카운터/ {
					sub(/^[ \t]+/, "", $2); printf "  %-12s: %s\n", $1, $2 }' \
				|| printf '  헤더        : 읽을 수 없다\n'
		fi
		if [ "$VERIFY" = yes ]; then
			if [ -z "$_dev" ] || [ ! -r "$_dev" ]; then
				printf '  LUKS 검증   : 건너뜀 (root 권한과 LUKS 장치가 필요)\n'
			else
				vb_workdir
				if vb_token_key "$_tok" && _vs=$(vb_test_slot "$_dev" "$WORK/token.key"); then
					printf '  LUKS 검증   : 통과 - 키슬롯 %s 을 연다\n' "${_vs:-?}"
				else
					printf '  LUKS 검증   : 실패! 이 토큰으로는 열리지 않는다\n'
				fi
			fi
		else
			printf '  LUKS 검증   : 생략 (--verify 로 실제 해제까지 확인)\n'
		fi
	fi

	printf '\n-- 부팅 카운터 --\n'
	if [ -r "$SEQ_STATE" ]; then
		awk -F= '$1 == "seq" { s = $2 } $1 == "token_uuid" { u = $2 }
			END { printf "  기록 (%s): seq=%s uuid=%s\n", FILENAME, s, u }' "$SEQ_STATE"
	else
		printf '  기록        : %s 없음 (아직 토큰으로 부팅한 적이 없다)\n' "$SEQ_STATE"
	fi
	if [ -r "$VB_RUN/boot-seq" ]; then
		awk -F= '$1 == "seq_seen" { a = $2 } $1 == "seq_written" { b = $2 }
			END { printf "  이번 부팅   : seq %s -> %s\n", a, b }' "$VB_RUN/boot-seq"
	else
		printf '  이번 부팅   : 토큰 기록 없음 (패스프레이즈로 부팅했거나 off 모드)\n'
	fi
	printf '  토큰 실측   : sudo vive-floppy-token seq show <토큰> (PIN 이 필요하다)\n'

	printf '\n-- 한 번만 우회 (viveboot=off) --\n'
	if vb_cmdline_word viveboot=off "$VB_CMDLINE" 2>/dev/null; then
		printf '  이번 부팅   : 우회됨 (토큰을 묻지 않았다)\n'
	else
		printf '  이번 부팅   : 우회 없음\n'
	fi
	if [ -r "$BOOT_CMDLINE" ]; then
		if vb_cmdline_word viveboot=off "$BOOT_CMDLINE"; then
			printf '  다음 부팅   : %s 에 viveboot=off 가 있다 -> 우회된다!\n' "$BOOT_CMDLINE"
			printf '                되돌리기: sudo vive-boot-mode bypass off\n'
		else
			printf '  다음 부팅   : 우회 없음 (%s)\n' "$BOOT_CMDLINE"
		fi
	fi
	if [ -r "$VB_CONF" ] && grep -qE '^[[:space:]]*BYPASS_CMDLINE=no' "$VB_CONF"; then
		printf '  설정        : BYPASS_CMDLINE=no - 우회가 꺼져 있다\n'
	fi
}

# ---------------------------------------------------------------------------

case $CMD in
on) cmd_on ;;
off) cmd_off ;;
status) cmd_status ;;
bypass) cmd_bypass ;;
esac
