# 부팅이 끝나고 — 모든 서비스가 올라온 다음 — 인트로를 한 번 재생한다 (콘솔/헤드리스).
# 데스크톱으로 부팅하는 기기는 이 서비스 대신 desktop/rpi5-bootintro.desktop 을 쓴다.
# 설치:  sudo scripts/install-bootintro.sh
[Unit]
Description=Raspberry Pi 5 boot intro (console)
Documentation=https://github.com/yunsee-jicsee-dev/Raspberrypi5_Eeprom-VIVE
# 부팅 과정에 끼어들지 않고, 올라올 서비스가 다 올라온 뒤에 돈다.
After=multi-user.target graphical.target display-manager.service systemd-user-sessions.service

[Service]
Type=oneshot
WorkingDirectory=/opt/rpi5-bootintro
ExecStart=/usr/bin/python3 /opt/rpi5-bootintro/bootintro.py --display fb --wait-fb 10 --fps 30 --optional --quiet
TimeoutStartSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
