# 일반 서비스가 다 올라온 뒤, 데스크톱(바탕화면) 이 뜨기 전에 인트로를 한 번 재생한다.
#
# multi-user.target 과 display-manager.service 사이가 유일하게 맞는 자리다.
#   - 그 앞:  올라올 서비스는 이미 다 올라왔다 (After=multi-user.target)
#   - 그 뒤:  컴포지터가 아직 시작되지 않아 /dev/fb0 이 우리 것이다
#            (Before=display-manager.service)
# 데스크톱 세션 안(XDG autostart) 에서 띄우면 바탕화면이 먼저 그려진 뒤에야
# 프로세스가 시작되므로 번쩍임을 없앨 수 없다.
#
# plymouth 에는 손대지 않는다. 여기서 `plymouth quit` 을 부르면
# plymouth-quit-wait.service(= plymouth --wait) 가 기다리던 대상을 밖에서
# 죽이는 꼴이라 그쪽이 실패한다. plymouth 스플래시가 화면을 쥐고 있어서
# 인트로가 안 보인다면 cmdline.txt 에서 splash 를 빼는 게 맞다
# (scripts/install-bootintro.sh --no-plymouth).
#
# 설치:  sudo scripts/install-bootintro.sh
[Unit]
Description=Raspberry Pi 5 boot intro
Documentation=https://github.com/yunsee-jicsee-dev/Raspberrypi5_Eeprom-VIVE
After=multi-user.target
Before=display-manager.service getty@tty1.service

[Service]
Type=oneshot
WorkingDirectory=/opt/rpi5-bootintro
ExecStart=/usr/bin/python3 /opt/rpi5-bootintro/bootintro.py --display auto --wait-fb 10 --fps 30 --optional
TimeoutStartSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
